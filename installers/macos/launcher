#!/usr/bin/env bash
# Entry point of the .app bundle. Finder doesn't open a Terminal for .app
# bundles, so our installation/setup script (start.command) would run
# blindly with no UI. We work around it by:
#
#   1. Copying the repo source from the bundle's Resources/ into
#      ~/Library/Application Support/BrawlhallaEditor (so .venv, downloaded
#      models, and per-user state survive app updates).
#
#   2. Asking Terminal.app to open start.command in a real, visible window.
#      The user sees install progress, can read errors, and can Ctrl+C if
#      something goes wrong.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
APP_BUNDLE="$(cd "$HERE/../.." && pwd)"
RESOURCES="$APP_BUNDLE/Contents/Resources"

APP_SUPPORT="$HOME/Library/Application Support/BrawlhallaEditor"
mkdir -p "$APP_SUPPORT"

if [ ! -d "$APP_SUPPORT/pipeline" ]; then
  rsync -a --delete \
    --exclude '.git' \
    --exclude '.venv' \
    --exclude '_local_jobs' \
    --exclude 'work' \
    --exclude 'output' \
    --exclude 'remotion/node_modules' \
    --exclude 'models/*.pt' \
    "$RESOURCES/repo/" "$APP_SUPPORT/"
fi

# Make sure start.command is up to date with what we just shipped — without
# this, an app update wouldn't propagate launcher fixes to existing installs.
cp -f "$RESOURCES/repo/start.command" "$APP_SUPPORT/start.command" 2>/dev/null || true
chmod +x "$APP_SUPPORT/start.command"

# Open in Terminal.app so the user actually sees the setup progress.
open -a Terminal "$APP_SUPPORT/start.command"
