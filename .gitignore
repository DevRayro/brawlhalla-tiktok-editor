.venv/
node_modules/
work/
output/
__pycache__/
*.pyc
.DS_Store
.env

# Local server runtime files
_local_jobs/

# Big model checkpoints (downloaded by setup, don't commit)
models/

# Remotion build artifacts
remotion/dist/
remotion/.cache/
remotion/out/
remotion/public/source.mp4
remotion/public/audio.m4a
remotion/public/*-source.mp4
remotion/public/*-audio.m4a

# Local user inputs (don't commit other people's clips)
input/*.mp4
input/*.mov
input/*.mkv
input/*.mp3
input/*.wav
input/*.m4a

# Mascot processing artifacts
deploy/_mascot-sources/

# First-run install marker (created when setup.bat / setup.sh complete)
.install-complete

# Build outputs from the installer scripts
dist/
remotion/public/*-base.mp4

# Generated icon scratch files (per-size PNGs are intermediate; source.png
# and the platform-specific outputs ARE committed so CI can ship icons
# without needing Pillow / iconutil).
icons/icon-*.png
_dmg_test/
